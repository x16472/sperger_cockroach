{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "啟動 Blazor WASM 開發伺服器",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "watch",
                "run",
                "--no-launch-profile",
                "--urls",
                "http://localhost:5044"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ASPNETCORE_ENVIRONMENT": "Development"
                }
            },
            "isBackground": true,
            "problemMatcher": [
                {
                    "owner": "blazor-wasm",
                    "severity": "info",
                    "pattern": {
                        "regexp": "^(.*)$",
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*",
                        "endsPattern": ".*Now listening on:\\s+http://localhost:5044"
                    }
                }
            ]
        }
    ]
}